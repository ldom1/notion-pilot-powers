{
  "mcpServers": {
    "notion-pilot-powers": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/ldom1/notion-pilot-powers@e6a901d14f87899969c6e49f9b99d1c3ec5e5274",
        "notion-pilot-powers"
      ],
      "env": {
        "NOTION_TOKEN": "${user_config.notion_token}",
        "NOTION_PEOPLE_DATA_SOURCE_ID": "${user_config.people_data_source_id}",
        "NOTION_COMPANIES_DATA_SOURCE_ID": "${user_config.companies_data_source_id}",
        "NOTION_DEALS_DATABASE_ID": "${user_config.deals_database_id}",
        "NOTION_ACTIVITIES_DATABASE_ID": "${user_config.activities_database_id}"
      }
    }
  }
}
